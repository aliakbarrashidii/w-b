# کپی کنید به .env و مقادیر را پر کنید
NODE_ENV=development
PORT=5000

# آدرس(های) کلاینت مجاز برای CORS — چند آدرس رو با کاما جدا کن (مثلاً با/بدون www)
CLIENT_URL=http://localhost:5173

# آدرس عمومی سایت (برای سایت‌مپ زنده‌ای که همین سرور تولید می‌کند)
SITE_URL=https://yourdomain.com

MONGODB_URI=mongodb://localhost:27017/wizel
JWT_SECRET=your_super_secret_key_change_this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# نام برند (برای متن ایمیل‌های اطلاع‌رسانی)
SITE_NAME=ویزل

# ایمیل (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=info@wizel.ir

# برای دریافت ایمیل از Gmail:
# 1. حساب Gmail خود را باز کنید
# 2. Settings > Security > 2-Step Verification را فعال کنید
# 3. Settings > Security > App Passwords برید
# 4. یک App Password برای Mail بسازید
# 5. آن رمز 16 رقمی را در EMAIL_PASS قرار دهید
